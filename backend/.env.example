NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/baotin
DB_SCHEMA=baotin_app
DB_SYNCHRONIZE=true
DB_SSL=false
# Supabase Session pooler: DB_SSL=true, keep certificate verification enabled.
# Downloaded public Supabase CA is included; unused when DB_SSL=false.
DB_SSL_CA_FILE=./certs/prod-ca-2021.crt
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3010,http://localhost:3000
SEED_MOCK_DATA=true
SEED_PASSWORD=replace-with-a-strong-demo-password
MEDIA_DIR=./media
