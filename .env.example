NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/baotin
DB_SCHEMA=baotin_app
DB_SYNCHRONIZE=true
DB_SSL=false
# Supabase Session pooler: DB_SSL=true, keep certificate verification enabled.
# Downloaded public Supabase CA is included; unused when DB_SSL=false.
DB_SSL_CA_FILE=./certs/prod-ca-2021.crt
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3010,http://localhost:3000
SEED_MOCK_DATA=true
SEED_PASSWORD=replace-with-a-strong-demo-password
# Use HOST=0.0.0.0 and COOKIE_SECURE=true on HTTPS cloud deployments.
MEDIA_DIR=./media
# Email recovery is unavailable until all three values are configured.
FRONTEND_URL=http://localhost:3010
SMTP_URL=
EMAIL_FROM=
# No scheduled sync or automatic external writes. Enable after testing mappings.
KIOTVIET_ENABLED=false
KIOTVIET_RETAILER=
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_BRANCH_MAP={}
