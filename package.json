{
  "name": "bao-tin-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently --kill-others -n compiler,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "fixtures": "node scripts/export-fixtures.mjs",
    "test": "npm run build && tsx --test test/domain.test.ts test/runtime.test.ts test/operations.test.ts",
    "test:operations": "npm run build && tsx --test test/operations-api.test.ts",
    "test:api": "tsx --test test/api.test.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "dev:local": "ENV_FILE=.env.local npm run dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
