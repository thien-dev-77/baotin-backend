{
  "name": "bao-tin-api",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently --kill-others -n compiler,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "fixtures": "node scripts/export-fixtures.mjs",
    "audit:mock-catalog": "node scripts/audit-mock-catalog.mjs",
    "cleanup:mock-catalog": "node scripts/cleanup-mock-catalog.mjs",
    "import:fulco": "npm run build && node scripts/import-fulco.mjs",
    "import:hafele": "npm run build && node scripts/import-hafele.mjs",
    "test:hafele": "npm run build && node --test test/hafele-import.test.mjs",
    "catalog:normalize-fulco": "npm run build && node scripts/normalize-fulco-categories.mjs",
    "catalog:normalize-hafele-names": "npm run build && node scripts/normalize-hafele-categories.mjs",
    "catalog:repair-homepage": "npm run build && node scripts/repair-homepage.mjs",
    "catalog:refresh-stock-names": "npm run build && node scripts/refresh-catalog.mjs",
    "catalog:reset-retail-discounts": "npm run build && node scripts/reset-retail-discounts.mjs",
    "test:retail-discounts": "npm run build && node --test test/retail-discounts.test.mjs",
    "test:catalog-refresh": "npm run build && node --test test/catalog-refresh.test.mjs",
    "test:homepage-repair": "npm run build && node --test test/homepage-repair.test.mjs",
    "test:category-tree": "npm run build && tsx --test test/category-tree.test.ts",
    "test:category-normalization": "npm run build && node --test test/category-normalization.test.mjs",
    "test": "npm run build && tsx --test test/domain.test.ts test/runtime.test.ts test/operations.test.ts test/product-pricing.test.ts",
    "test:operations": "npm run build && tsx --test test/operations-api.test.ts",
    "test:products": "npm run build && tsx --test test/products-api.test.ts",
    "test:experience": "npm run build && tsx --test test/experience-api.test.ts",
    "test:customers": "npm run build && tsx --test test/customers-api.test.ts",
    "test:categories": "npm run build && tsx --test test/categories-api.test.ts",
    "test:catalog": "npm run build && tsx --test test/catalog-query-api.test.ts",
    "test:materials": "npm run build && tsx --test test/material-groups.test.ts test/catalog-query-api.test.ts",
    "catalog:sync-filters": "npm run build && node scripts/sync-product-filter-attributes.mjs",
    "test:product-filters": "npm run build && node --import tsx --test test/material-groups.test.ts test/product-filter-attributes.test.ts test/catalog-query-api.test.ts test/products-api.test.ts test/product-filter-sync.test.mjs",
    "test:admin-resources": "npm run build && tsx --test test/admin-resources-api.test.ts",
    "test:mock-cleanup": "npm run build && node --test test/mock-cleanup.test.mjs",
    "test:fulco": "npm run build && node --test test/fulco-import.test.mjs",
    "test:product-bulk": "npm run build && node --test test/product-bulk.test.mjs",
    "test:variant-copy": "npm run build && node --test test/product-variant-copy.test.mjs",
    "test:variant-groups": "npm run build && node --test test/product-variant-groups.test.mjs",
    "test:variant-attach": "npm run build && node --test test/product-variant-attach.test.mjs",
    "test:product-optimizations": "npm run build && node --test test/proxy-client-ip.test.mjs test/product-editor-quote-api.test.mjs",
    "test:media-storage": "npm run build && node --test test/product-media-storage.test.mjs",
    "test:api": "tsx --test test/api.test.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "dev:local": "ENV_FILE=.env.local npm run dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
